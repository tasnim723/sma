import os

root_dir = r"c:\Users\LENOVO\Downloads\PROJET_SMA (2)\PROJET_SMA\pfe-main (2)\pfe-main\pfe-main\frontend"

for root, dirs, files in os.walk(root_dir):
    for file in files:
        if file.endswith(('.tsx', '.ts', '.js')):
            path = os.path.join(root, file)
            with open(path, 'r', encoding='utf-8', errors='ignore') as f:
                lines = f.readlines()
            
            if not lines:
                continue
                
            # Check if "use client" is not on the first line but exists in the first few lines
            use_client_idx = -1
            for i, line in enumerate(lines[:10]):
                if '"use client"' in line or "'use client'" in line:
                    use_client_idx = i
                    break
            
            if use_client_idx > 0:
                # Move it to the top
                use_client_line = lines.pop(use_client_idx)
                # Ensure it has a newline and is correctly formatted
                if not use_client_line.endswith('\n'):
                    use_client_line += '\n'
                
                # Insert at index 0
                lines.insert(0, use_client_line)
                
                with open(path, 'w', encoding='utf-8') as f:
                    f.writelines(lines)
                print(f"Fixed 'use client' position: {path}")
